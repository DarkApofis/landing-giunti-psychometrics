{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "landing-version-b",
  "private": true,
  "type": "module",
  "description": "Front-end build of version B: Stylus + jQuery compiled by Gulp into public/build.",
  "scripts": {
    "dev": "concurrently --kill-others --names gulp,php --prefix-colors cyan,magenta \"gulp dev\" \"php artisan serve\"",
    "build": "gulp build",
    "clean": "gulp clean",
    "sync:handoff": "node scripts/sync-handoff.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "e2e:screenshots": "playwright test e2e/screenshots.spec.ts",
    "compare:screenshots": "node scripts/compare-screenshots.mjs",
    "test": "node --test \"tests/js/**/*.test.mjs\"",
    "lint": "eslint resources/js gulpfile.mjs scripts tests/js eslint.config.js"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "autoprefixer": "10.6.2",
    "concurrently": "10.0.6",
    "cssnano": "9.9.0",
    "del": "9.0.1",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "gulp": "5.0.1",
    "gulp-concat": "2.6.1",
    "gulp-postcss": "10.0.0",
    "gulp-rev": "12.0.0",
    "gulp-rev-rewrite": "7.0.0",
    "gulp-terser": "2.1.0",
    "jquery": "4.0.0",
    "lucide-static": "1.67.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.32",
    "stylus": "0.64.0",
    "through2": "5.0.12",
    "vinyl-sourcemaps-apply": "0.2.1"
  },
  "overrides": {
    "stylus": {
      "glob": "14.0.3"
    }
  }
}
