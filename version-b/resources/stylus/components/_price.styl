// Price hierarchy (DESIGN-SPEC §6.2). Mirrors version-a/src/components/ui/Price.tsx:
// final price 24/700 Figtree (tabular) → struck original 14px ink-muted → saving chip 12/700 on accent-subtle.
.price {
  font-family: var(--font-display);
  font-size: var(--text-price);
  line-height: var(--text-price-line-height);
  font-weight: 700;
  color: var(--color-ink);
  font-variant-numeric: tabular-nums;

  // With a discount the three parts sit on one baseline and wrap if needed.
  &--discounted {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
    row-gap: 0.25rem;
  }

  &__original {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: unquote('calc(1.25 / 0.875)');
    font-weight: 400;
    color: var(--color-ink-muted);
  }

  &__saving {
    align-self: center;
    border-radius: var(--radius-full);
    background-color: var(--color-accent-subtle);
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    line-height: unquote('calc(1 / 0.75)');
    font-weight: 700;
    color: var(--color-ink);
  }

  // "IVA inclusa" under the price.
  &__vat {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    line-height: unquote('calc(1 / 0.75)');
    color: var(--color-ink-muted);
  }
}
