// Format badge (DESIGN-SPEC §1.3, §6.2). Mirrors version-a/src/components/ui/FormatBadge.tsx:
// icon + text + tint, never colour alone (+ sr-only "Formato:"). 28px high, border = text colour at 20 %.
.format-badge {
  display: inline-flex;
  height: 1.75rem;
  align-items: center;
  gap: 0.375rem;
  border: 1px solid;
  border-radius: var(--radius-full);
  padding-inline: 0.625rem;
  font-family: var(--font-display);
  font-size: 0.75rem;
  line-height: unquote('calc(1 / 0.75)');
  font-weight: 600;
  white-space: nowrap;

  &--cartaceo {
    border-color: var(--color-format-cartaceo-a20);
    background-color: var(--color-format-cartaceo-subtle);
    color: var(--color-format-cartaceo);
  }

  &--digitale {
    border-color: var(--color-format-digitale-a20);
    background-color: var(--color-format-digitale-subtle);
    color: var(--color-format-digitale);
  }

  &--online {
    border-color: var(--color-format-online-a20);
    background-color: var(--color-format-online-subtle);
    color: var(--color-format-online);
  }

  &--presenza {
    border-color: var(--color-format-presenza-a20);
    background-color: var(--color-format-presenza-subtle);
    color: var(--color-format-presenza);
  }
}
