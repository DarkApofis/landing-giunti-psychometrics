// Header search (DESIGN-SPEC §6.4). Width: 100 % on a second row (< 768), then flex 1 up to 28rem,
// 20rem from 1024px. Mirrors version-a/src/components/layout/SearchBox.tsx.
.site-search {
  order: 9999;
  width: 100%;
  padding-bottom: 0.75rem;

  +md() {
    order: 0;
    margin-left: auto;
    max-width: 28rem;
    flex: 1;
    padding-bottom: 0;
  }

  +lg() {
    max-width: 20rem;
  }

  &__form {
    position: relative;
  }

  &__icon {
    pointer-events: none;
    position: absolute;
    top: 50%;
    left: 0.75rem;
    width: 1.25rem;
    height: 1.25rem;
    translate: 0 -50%;
    color: var(--color-ink-muted);
  }

  &__input {
    height: 2.75rem;
    width: 100%;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    padding-right: 2.75rem;
    padding-left: 2.5rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink);
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
    transition-timing-function: var(--ease-out);
    transition-duration: var(--duration-fast);

    &::placeholder {
      color: var(--color-ink-muted);
    }

    +hover() {
      border-color: var(--color-ink);
    }

    &:focus-visible {
      border-color: var(--color-primary);
    }
  }

  &__clear {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    place-items: center;
    border-radius: var(--radius-md);
    color: var(--color-ink-muted);
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
    transition-timing-function: var(--ease-out);
    transition-duration: var(--duration-fast);

    +hover() {
      color: var(--color-ink);
    }
  }
}
