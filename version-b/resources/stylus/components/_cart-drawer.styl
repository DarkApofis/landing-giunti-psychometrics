// Cart drawer (DESIGN-SPEC §6.7). Mirrors version-a/src/components/layout/CartDrawer.tsx and QuantityStepper.tsx.
// A native modal <dialog> anchored to the right, full height, min(26rem, 100vw) wide; it slides in
// (250 ms, @starting-style) and closes instantly.
.cart-drawer {
  position: fixed;
  inset-block: 0;
  right: 0;
  left: auto;
  margin: 0;
  height: 100dvh;
  max-height: none;
  width: unquote('min(26rem, 100vw)'); // Stylus has its own min(): keep the CSS one
  max-width: none;
  background-color: var(--color-surface);
  padding: 0;
  color: var(--color-ink);
  box-shadow: var(--shadow-overlay);
  transition-property: transform, translate, scale, rotate;
  transition-duration: var(--duration-enter);
  transition-timing-function: var(--ease-standard);

  &::backdrop {
    background-color: var(--color-backdrop);
  }

  &__inner {
    display: flex;
    height: 100%;
    flex-direction: column;
  }

  &__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 1.25rem;
  }

  &__title {
    font-size: 1.25rem;
    line-height: unquote('calc(1.75 / 1.25)');
    font-weight: 700;
  }

  &__count {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 400;
    color: var(--color-ink-muted);
  }

  &__close {
    icon-button();
  }

  // Empty cart
  &__empty {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-inline: 1.5rem;
    text-align: center;
  }

  &__empty-icon {
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    border-radius: var(--radius-full);
    background-color: var(--color-primary-subtle);
    color: var(--color-primary);
  }

  &__empty-title {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: unquote('calc(1.75 / 1.125)');
    font-weight: 600;
  }

  &__empty-text {
    margin-top: 0.25rem;
    max-width: 20rem;
    font-size: 0.875rem;
    line-height: unquote('calc(1.25 / 0.875)');
    color: var(--color-ink-muted);
  }

  &__empty-action {
    margin-top: 1.5rem;
  }

  // Lines + footer
  &__content {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
  }

  &__list {
    flex: 1;
    overflow-y: auto;
    padding-inline: 1.25rem;

    > :not(:last-child) {
      border-bottom: 1px solid var(--color-border);
    }
  }

  &__foot {
    border-top: 1px solid var(--color-border);
    padding: 1.25rem;
  }

  &__totals > * + * {
    margin-top: 0.375rem;
  }

  &__total-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;

    &.is-saving {
      font-size: 0.875rem;
      line-height: unquote('calc(1.25 / 0.875)');
      color: var(--color-success);
    }
  }

  &__subtotal-label {
    font-family: var(--font-display);
    font-weight: 600;
  }

  &__subtotal {
    font-family: var(--font-display);
    font-size: var(--text-price);
    line-height: var(--text-price-line-height);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  &__savings {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  &__vat {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    line-height: unquote('calc(1 / 0.75)');
    color: var(--color-ink-muted);
  }

  &__checkout {
    margin-top: 1rem;
  }

  &__note {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.75rem;
    line-height: unquote('calc(1 / 0.75)');
    color: var(--color-ink-muted);
  }

  &__clear {
    margin-top: 0.5rem;
  }
}

// Slide-in from the right when the drawer opens. Literal CSS: Stylus does not know @starting-style.
@css {
@starting-style {
  .cart-drawer[open] {
    translate: 100% 0;
  }
}
}

.cart-line {
  display: flex;
  gap: 1rem;
  padding-block: 1rem;

  &__thumb {
    position: relative;
    width: 4rem;
    height: 4rem;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-primary-subtle);
  }

  &__img {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    color: transparent;
  }

  &__body {
    min-width: 0;
    flex: 1;
  }

  &__name {
    font-size: 0.875rem;
    line-height: 1.375;
    font-weight: 600;
  }

  &__meta {
    margin-top: 0.125rem;
    font-size: 0.75rem;
    line-height: unquote('calc(1 / 0.75)');
    color: var(--color-ink-muted);
  }

  &__unit {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: unquote('calc(1.25 / 0.875)');
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }

  &__row {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  &__total {
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  // "Rimuovi": danger text, 44px target, danger-subtle on hover.
  &__remove {
    margin-top: 0.25rem;
    margin-left: -0.5rem;
    display: inline-flex;
    min-height: 2.75rem;
    cursor: pointer;
    align-items: center;
    gap: 0.375rem;
    border-radius: var(--radius-md);
    padding-inline: 0.5rem;
    font-size: 0.875rem;
    line-height: unquote('calc(1.25 / 0.875)');
    font-weight: 500;
    color: var(--color-danger);
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
    transition-timing-function: var(--ease-out);
    transition-duration: var(--duration-fast);

    +hover() {
      background-color: var(--color-danger-subtle);
    }
  }
}

// − value + with 44px targets. Limits use aria-disabled (not disabled) so focus is never lost.
.stepper {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-md);
  background-color: var(--color-surface);

  &__btn {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    place-items: center;
    color: var(--color-ink);
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
    transition-timing-function: var(--ease-out);
    transition-duration: var(--duration-fast);

    &:first-child {
      border-top-left-radius: var(--radius-md);
      border-bottom-left-radius: var(--radius-md);
    }

    &:last-child {
      border-top-right-radius: var(--radius-md);
      border-bottom-right-radius: var(--radius-md);
    }

    +hover() {
      background-color: var(--color-primary-subtle);
    }

    &[aria-disabled='true'] {
      cursor: not-allowed;
      color: var(--color-ink-muted);

      +hover() {
        background-color: transparent;
      }
    }
  }

  &__value {
    min-width: 2rem;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
}
