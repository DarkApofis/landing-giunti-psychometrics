// Category pills (DESIGN-SPEC §6.3). Mirrors version-a/src/components/sections/CategoryFilter.tsx.
// < 768px: one horizontal row that scrolls, full bleed to the screen edges (a cut pill hints at more);
// vertical padding keeps the focus ring from being clipped; no scroll-snap (it fought keyboard focus,
// docs/AUDIT.md H2). From 768px the pills wrap.
.category-filter {
  margin-inline: -1rem;
  scroll-padding-inline: 1rem;
  scrollbar-width: thin;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  padding: 0.25rem 1rem;

  +md() {
    margin-inline: 0;
    overflow: visible;
    padding-inline: 0;
  }

  &__list {
    display: flex;
    width: max-content;
    gap: 0.5rem;

    +md() {
      width: auto;
      flex-wrap: wrap;
    }
  }
}

.pill {
  display: inline-flex;
  min-height: 2.75rem;
  cursor: pointer;
  align-items: center;
  gap: 0.5rem;
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-full);
  background-color: var(--color-surface);
  padding-inline: 1rem;
  font-family: var(--font-display);
  font-size: 0.9375rem;
  font-weight: 500;
  white-space: nowrap;
  color: var(--color-ink);
  transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
  transition-timing-function: var(--ease-out);
  transition-duration: var(--duration-fast);

  +hover() {
    background-color: var(--color-primary-subtle);
  }

  // Check icon only on the active pill.
  &__check {
    display: none;
    margin-left: -0.25rem;
  }

  // Count chip (aria-hidden: the button's aria-label already says "{label} {n} prodotti").
  &__count {
    min-width: 1.5rem;
    border-radius: var(--radius-full);
    background-color: var(--color-primary-subtle);
    padding-inline: 0.375rem;
    text-align: center;
    font-size: 0.75rem;
    line-height: unquote('calc(1 / 0.75)');
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  // Active: primary fill (state driven by aria-pressed, mirrored by .is-active).
  &[aria-pressed='true'] {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-white);

    +hover() {
      background-color: var(--color-primary-hover);
    }

    .pill__check {
      display: block;
    }

    .pill__count {
      background-color: var(--color-white-a20);
      color: var(--color-white);
    }
  }
}
