// Details dialog of the tests (DESIGN-SPEC §6.12). Mirrors version-a/src/components/sections/ProductDialog.tsx.
// The preflight resets the UA margins/padding/border of <dialog>: size, centring and surface are set here.
.product-dialog {
  margin: auto;
  max-height: calc(100dvh - 2rem);
  width: unquote('min(40rem, calc(100vw - 2rem))'); // Stylus has its own min(): keep the CSS one
  overflow-y: auto;
  border-radius: var(--radius-lg);
  background-color: var(--color-surface);
  padding: 0;
  color: var(--color-ink);
  box-shadow: var(--shadow-overlay);

  &::backdrop {
    background-color: var(--color-backdrop);
  }

  &__inner {
    position: relative;
  }

  // White circle over the photo, first in the DOM (initial focus).
  &__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 10;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    place-items: center;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-card);
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
    transition-timing-function: var(--ease-out);
    transition-duration: var(--duration-fast);

    +hover() {
      background-color: var(--color-primary-subtle);
    }
  }

  &__media {
    position: relative;
    aspect-ratio: 16 / 7;
    background-color: var(--color-primary-subtle);
  }

  &__img {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    color: transparent;
  }

  &__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
  }

  &__body {
    padding: 1.5rem;
  }

  &__title {
    margin-top: 0.5rem;
    font-size: 1.5rem;
    line-height: 1.25;
    font-weight: 700;
  }

  &__desc {
    margin-top: 0.75rem;
    color: var(--color-ink-muted);
  }

  &__meta {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.5rem;
    row-gap: 0.5rem;
    font-size: 0.875rem;
    line-height: unquote('calc(1.25 / 0.875)');

    dt {
      color: var(--color-ink-muted);
    }

    dd {
      font-weight: 500;
    }
  }

  // Price + note on the left, "Richiedi informazioni" on the right from 640px.
  &__footer {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;

    +sm() {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
}

// Qualification required to buy a test (A/B/C), explained before contacting.
.qualification-note {
  margin-top: 1.25rem;
  border: 1px solid var(--color-primary-a30);
  border-radius: var(--radius-md);
  background-color: var(--color-primary-subtle);
  padding: 1rem;
  font-size: 0.875rem;
  line-height: unquote('calc(1.25 / 0.875)');

  &__title {
    font-family: var(--font-display);
    font-weight: 600;
  }

  &__text {
    margin-top: 0.25rem;
    color: var(--color-ink);
  }
}
