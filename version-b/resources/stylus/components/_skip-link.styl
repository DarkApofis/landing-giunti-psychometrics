// Skip link (DESIGN-SPEC §6.14): the first focusable element, visible only while focused.
.skip-link {
  position: fixed;
  top: 0.5rem;
  left: 0.5rem;
  z-index: 50;
  translate: 0 -6rem;
  border-radius: var(--radius-md);
  background-color: var(--color-primary);
  padding: 0.75rem 1rem;
  font-family: var(--font-display);
  font-weight: 600;
  color: var(--color-white);
  box-shadow: var(--shadow-overlay);

  &:focus-visible {
    translate: 0 0;
    outline-offset: 4px;
  }
}
