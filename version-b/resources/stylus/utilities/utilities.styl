// Utilities: last in the cascade, one purpose each.

// Visually hidden but still announced by screen readers (same declarations as Tailwind's sr-only).
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
  border-width: 0;
}
