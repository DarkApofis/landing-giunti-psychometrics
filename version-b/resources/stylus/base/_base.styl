// Global base, exactly as docs/HANDOFF-LARAVEL.md §1 "Base global" (= version-a/src/app/globals.css).

html {
  -webkit-text-size-adjust: 100%;
}

// The header is sticky only when the viewport is at least 30rem tall (docs/AUDIT.md H4); anchored
// sections then need room for it. Below that height the header scrolls away and needs no padding.
+tall() {
  html {
    scroll-padding-top: calc(var(--header-h-mobile) + 1rem);
  }
}

+tall-from($bp-md) {
  html {
    scroll-padding-top: calc(var(--header-h) + 1rem);
  }
}

+tall-from($bp-lg) {
  html {
    scroll-padding-top: calc(var(--header-h-lg) + 1rem);
  }
}

+motion-safe() {
  html {
    scroll-behavior: smooth;
  }
}

body {
  background-color: var(--color-canvas);
  color: var(--color-ink);
  font-family: var(--font-sans);
  font-size: 1rem;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

h1,
h2,
h3,
h4 {
  font-family: var(--font-display);
  text-wrap: balance;
}

p {
  text-wrap: pretty;
}

// Focus (DESIGN-SPEC §4): visible for keyboard users only, never removed without a replacement.
:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

.on-dark :focus-visible {
  outline-color: var(--color-white);
}

// While a modal <dialog> is open, the page behind it does not scroll.
html:has(dialog[open]) {
  overflow: hidden;
}

// <main tabindex="-1"> receives focus from the skip link; it is not a control, so it gets no ring.
main:focus {
  outline: none;
}

// The search box provides its own clear button: hide the native one.
input[type='search']::-webkit-search-cancel-button {
  appearance: none;
}

// Reduced motion: no animations, 1 ms transitions, instant scrolling.
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 1ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 1ms !important;
    scroll-behavior: auto !important;
  }
}
