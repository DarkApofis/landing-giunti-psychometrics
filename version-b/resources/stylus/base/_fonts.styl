// Self-hosted variable fonts from @fontsource-variable (latin subset only, docs/ASSUMPTIONS.md B13), with
// the same unicode-range as the latin block next/font emits for version-a. Gulp copies the files to
// public/fonts and rewrites these URLs to the hashed names (the CSS lives in public/build/css).
//
// The fallback faces carry the metric overrides next/font computed for version-a, copied from its
// compiled CSS (version-a/.next/static/chunks/*.css), so text does not shift when the web fonts arrive.
//
// Literal CSS: Stylus would try to evaluate the unicode-range values and the space-separated weights.

@css {
@font-face {
  font-family: 'Figtree';
  font-style: normal;
  font-weight: 300 900;
  font-display: swap;
  src: url('../../fonts/figtree-latin-wght-normal.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'Noto Sans';
  font-style: normal;
  font-weight: 100 900;
  font-stretch: 100%;
  font-display: swap;
  src: url('../../fonts/noto-sans-latin-wght-normal.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'Figtree Fallback';
  src: local('Arial');
  ascent-override: 94.32%;
  descent-override: 24.82%;
  line-gap-override: 0%;
  size-adjust: 100.72%;
}

@font-face {
  font-family: 'Noto Sans Fallback';
  src: local('Arial');
  ascent-override: 100.54%;
  descent-override: 27.56%;
  line-gap-override: 0%;
  size-adjust: 106.33%;
}
}
