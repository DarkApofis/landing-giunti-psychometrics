// Design tokens — Giunti Psychometrics.
// Source: docs/HANDOFF-LARAVEL.md §1 and docs/DESIGN-SPEC.md §1–5; values mirror version-a/src/styles/tokens.css.
// This is the ONLY file allowed to contain raw colour values (npm run check:tokens).
//
// Two faces of the same values:
//   - Stylus variables ($color-primary…): for build-time use (e.g. inside @media, mixins).
//   - CSS custom properties (--color-primary…) on :root: what components use at runtime.
//
// Stylus gotchas (docs/ASSUMPTIONS.md B19): write alpha colours as rgba(r, g, b, a) with commas; the
// slash syntax rgb(r g b / a) is silently miscomputed. clamp() and color-mix() go through unquote(),
// otherwise Stylus evaluates (and breaks) their arguments.

// ── §1.1 Brand (mandatory) ──────────────────────────────────────────────────
$color-primary = #1b4f8a;
$color-ink = #0f2d52;
$color-accent = #0ea5e9;            // decorative / background only: 2.77:1 on white
$color-canvas = #eff6ff;

// ── §1.2 Derived ────────────────────────────────────────────────────────────
$color-primary-hover = #153f6f;
$color-primary-active = #10335a;
$color-primary-subtle = #dbeafe;
$color-accent-strong = #0369a1;
$color-accent-subtle = #e0f2fe;
$color-surface = #ffffff;
$color-ink-muted = #4a607d;
$color-border = #c7d7ec;
$color-border-strong = #6b84a3;
$color-danger = #b42318;
$color-danger-subtle = #fef3f2;
$color-success = #1a7f37;
$color-success-subtle = #ecfdf3;
$color-white = #ffffff;
$color-backdrop = rgba(15, 45, 82, 0.5);

// ── §1.3 Format badges (text / background) ──────────────────────────────────
$color-format-cartaceo = #7a3e00;
$color-format-cartaceo-subtle = #fef0c7;
$color-format-digitale = #0b4a6f;
$color-format-digitale-subtle = #e0f2fe;
$color-format-online = #4a2c8f;
$color-format-online-subtle = #ede7fb;
$color-format-presenza = #14532d;
$color-format-presenza-subtle = #dcfce7;

// ── §2 Typography ───────────────────────────────────────────────────────────
$font-display = 'Figtree', 'Figtree Fallback', ui-sans-serif, system-ui, sans-serif;
$font-sans = 'Noto Sans', 'Noto Sans Fallback', ui-sans-serif, system-ui, sans-serif;
$text-display = unquote('clamp(2rem, 1.4rem + 3vw, 3.25rem)');
$text-h2 = unquote('clamp(1.75rem, 1.5rem + 1vw, 2.25rem)');

// ── §3 Layout ───────────────────────────────────────────────────────────────
$container-page = 75rem;
$header-h-mobile = 7.5rem;          // 64px row + 56px search row (< 768px)
$header-h = 4rem;
$header-h-lg = 4.5rem;

// ── §4 Radii and shadows ────────────────────────────────────────────────────
$radius-sm = 6px;
$radius-md = 8px;
$radius-lg = 12px;
$radius-full = unquote('calc(infinity * 1px)'); // Tailwind 4's rounded-full, as version-a (was 9999px: same look)
$shadow-card = 0 1px 2px rgba(15, 45, 82, 0.06), 0 1px 3px rgba(15, 45, 82, 0.08);
$shadow-card-hover = 0 8px 24px -6px rgba(15, 45, 82, 0.18);
$shadow-overlay = 0 16px 48px -12px rgba(15, 45, 82, 0.35);

// ── §5 Motion ───────────────────────────────────────────────────────────────
$ease-standard = cubic-bezier(0.2, 0.8, 0.2, 1);
$ease-exit = cubic-bezier(0.4, 0, 1, 1);
$ease-out = cubic-bezier(0, 0, 0.2, 1);   // Tailwind's ease-out, used by version-a's colour transitions
$duration-fast = 150ms;
$duration-base = 200ms;
$duration-enter = 250ms;

// Same color-mix() Tailwind 4 emits for `primary/40`, `white/60`… in version-a (identical computed colour).
mix-alpha($token, $percent) {
  return unquote('color-mix(in oklab, var(--color-' + $token + ') ' + $percent + '%, transparent)');
}

:root {
  --color-primary: $color-primary;
  --color-ink: $color-ink;
  --color-accent: $color-accent;
  --color-canvas: $color-canvas;

  --color-primary-hover: $color-primary-hover;
  --color-primary-active: $color-primary-active;
  --color-primary-subtle: $color-primary-subtle;
  --color-accent-strong: $color-accent-strong;
  --color-accent-subtle: $color-accent-subtle;
  --color-surface: $color-surface;
  --color-ink-muted: $color-ink-muted;
  --color-border: $color-border;
  --color-border-strong: $color-border-strong;
  --color-danger: $color-danger;
  --color-danger-subtle: $color-danger-subtle;
  --color-success: $color-success;
  --color-success-subtle: $color-success-subtle;
  --color-white: $color-white;
  --color-backdrop: $color-backdrop;

  // §1.2 Opacities in use (DESIGN-SPEC §1.2)
  --color-primary-a40: mix-alpha('primary', 40);
  --color-primary-a30: mix-alpha('primary', 30);
  --color-accent-a35: mix-alpha('accent', 35);
  --color-white-a60: mix-alpha('white', 60);
  --color-white-a50: mix-alpha('white', 50);
  --color-white-a25: mix-alpha('white', 25);
  --color-white-a20: mix-alpha('white', 20);
  --color-white-a15: mix-alpha('white', 15);
  --color-white-a10: mix-alpha('white', 10);
  --color-white-a9: mix-alpha('white', 9);
  --color-danger-a30: mix-alpha('danger', 30);
  --color-success-a30: mix-alpha('success', 30);

  --color-format-cartaceo: $color-format-cartaceo;
  --color-format-cartaceo-subtle: $color-format-cartaceo-subtle;
  --color-format-digitale: $color-format-digitale;
  --color-format-digitale-subtle: $color-format-digitale-subtle;
  --color-format-online: $color-format-online;
  --color-format-online-subtle: $color-format-online-subtle;
  --color-format-presenza: $color-format-presenza;
  --color-format-presenza-subtle: $color-format-presenza-subtle;
  // Badge border = text colour at 20 %
  --color-format-cartaceo-a20: mix-alpha('format-cartaceo', 20);
  --color-format-digitale-a20: mix-alpha('format-digitale', 20);
  --color-format-online-a20: mix-alpha('format-online', 20);
  --color-format-presenza-a20: mix-alpha('format-presenza', 20);

  --font-display: $font-display;
  --font-sans: $font-sans;
  --text-display: $text-display;
  --text-display-line-height: 1.1;
  --text-display-letter-spacing: -0.02em;
  --text-h2: $text-h2;
  --text-h2-line-height: 1.2;
  --text-h2-letter-spacing: -0.01em;
  --text-price: 1.5rem;
  --text-price-line-height: 1;
  --text-eyebrow: 0.75rem;
  --text-eyebrow-line-height: 1.2;
  --text-eyebrow-letter-spacing: 0.06em;

  --container-page: $container-page;
  --header-h-mobile: $header-h-mobile;
  --header-h: $header-h;
  --header-h-lg: $header-h-lg;

  --radius-sm: $radius-sm;
  --radius-md: $radius-md;
  --radius-lg: $radius-lg;
  --radius-full: $radius-full;
  --shadow-card: $shadow-card;
  --shadow-card-hover: $shadow-card-hover;
  --shadow-overlay: $shadow-overlay;

  --ease-standard: $ease-standard;
  --ease-exit: $ease-exit;
  --ease-out: $ease-out;
  --duration-fast: $duration-fast;
  --duration-base: $duration-base;
  --duration-enter: $duration-enter;
}
