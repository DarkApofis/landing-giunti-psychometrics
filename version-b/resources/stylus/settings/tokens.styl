// Design tokens — Giunti Psychometrics (docs/HANDOFF-LARAVEL.md §1, docs/DESIGN-SPEC.md §1–5).
// This is the ONLY file allowed to contain raw colour values (npm run check:tokens).
// Values mirror version-a/src/styles/tokens.css one to one.
//
// Written as literal CSS inside @css: Stylus evaluates rgb() and clamp() arguments and silently
// corrupts them (rgb(15 45 82 / 0.5) -> #0f2da4, clamp(2rem, 1.4rem + 3vw, ...) -> clamp(2rem, 4.4rem, ...)),
// and it cannot parse color-mix(in ...). See docs/ASSUMPTIONS.md B19.

@css {
:root {
  /* §1.1 Brand (mandatory) */
  --color-primary: #1b4f8a;
  --color-ink: #0f2d52;
  --color-accent: #0ea5e9; /* decorative / background only: 2.77:1 on white */
  --color-canvas: #eff6ff;

  /* §1.2 Derived */
  --color-primary-hover: #153f6f;
  --color-primary-active: #10335a;
  --color-primary-subtle: #dbeafe;
  --color-accent-strong: #0369a1;
  --color-accent-subtle: #e0f2fe;
  --color-surface: #ffffff;
  --color-ink-muted: #4a607d;
  --color-border: #c7d7ec;
  --color-border-strong: #6b84a3;
  --color-danger: #b42318;
  --color-danger-subtle: #fef3f2;
  --color-success: #1a7f37;
  --color-success-subtle: #ecfdf3;
  --color-white: #ffffff;
  --color-backdrop: rgb(15 45 82 / 0.5);

  /* §1.2 Opacities in use: the same color-mix() Tailwind 4 emits for primary/40 etc. in version-a */
  --color-primary-a40: color-mix(in oklab, var(--color-primary) 40%, transparent);
  --color-primary-a30: color-mix(in oklab, var(--color-primary) 30%, transparent);
  --color-accent-a35: color-mix(in oklab, var(--color-accent) 35%, transparent);
  --color-white-a60: color-mix(in oklab, var(--color-white) 60%, transparent);
  --color-white-a50: color-mix(in oklab, var(--color-white) 50%, transparent);
  --color-white-a25: color-mix(in oklab, var(--color-white) 25%, transparent);
  --color-white-a20: color-mix(in oklab, var(--color-white) 20%, transparent);
  --color-white-a15: color-mix(in oklab, var(--color-white) 15%, transparent);
  --color-white-a10: color-mix(in oklab, var(--color-white) 10%, transparent);
  --color-white-a9: color-mix(in oklab, var(--color-white) 9%, transparent);
  --color-danger-a30: color-mix(in oklab, var(--color-danger) 30%, transparent);
  --color-success-a30: color-mix(in oklab, var(--color-success) 30%, transparent);

  /* §1.3 Format badges (text / background; border = text at 20 %) */
  --color-format-cartaceo: #7a3e00;
  --color-format-cartaceo-subtle: #fef0c7;
  --color-format-digitale: #0b4a6f;
  --color-format-digitale-subtle: #e0f2fe;
  --color-format-online: #4a2c8f;
  --color-format-online-subtle: #ede7fb;
  --color-format-presenza: #14532d;
  --color-format-presenza-subtle: #dcfce7;

  /* §2 Typography */
  --font-display: 'Figtree', 'Figtree Fallback', ui-sans-serif, system-ui, sans-serif;
  --font-sans: 'Noto Sans', 'Noto Sans Fallback', ui-sans-serif, system-ui, sans-serif;
  --text-display: clamp(2rem, 1.4rem + 3vw, 3.25rem);
  --text-display-line-height: 1.1;
  --text-display-letter-spacing: -0.02em;
  --text-h2: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
  --text-h2-line-height: 1.2;
  --text-h2-letter-spacing: -0.01em;
  --text-price: 1.5rem;
  --text-price-line-height: 1;
  --text-eyebrow: 0.75rem;
  --text-eyebrow-line-height: 1.2;
  --text-eyebrow-letter-spacing: 0.06em;

  /* §3 Layout */
  --container-page: 75rem;
  --header-h-mobile: 7.5rem; /* 64px row + 56px search row (< 768px) */
  --header-h: 4rem;
  --header-h-lg: 4.5rem;

  /* §4 Radii and shadows */
  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-full: 9999px;
  --shadow-card: 0 1px 2px rgb(15 45 82 / 0.06), 0 1px 3px rgb(15 45 82 / 0.08);
  --shadow-card-hover: 0 8px 24px -6px rgb(15 45 82 / 0.18);
  --shadow-overlay: 0 16px 48px -12px rgb(15 45 82 / 0.35);

  /* §5 Motion */
  --ease-standard: cubic-bezier(0.2, 0.8, 0.2, 1);
  --ease-exit: cubic-bezier(0.4, 0, 1, 1);
  --duration-fast: 150ms;
  --duration-base: 200ms;
  --duration-enter: 250ms;
}
}
