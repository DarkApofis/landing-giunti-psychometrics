# nginx for the version B container. ${PORT} is substituted at start (docker/entrypoint.sh).
# Runs as the unprivileged www-data user: pid and temp files live in /tmp.
load_module /usr/lib/nginx/modules/ngx_http_brotli_filter_module.so;
load_module /usr/lib/nginx/modules/ngx_http_brotli_static_module.so;

worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server_tokens off;
    sendfile on;
    keepalive_timeout 65;
    client_body_temp_path /tmp/nginx-client-body;
    proxy_temp_path /tmp/nginx-proxy;
    fastcgi_temp_path /tmp/nginx-fastcgi;
    uwsgi_temp_path /tmp/nginx-uwsgi;
    scgi_temp_path /tmp/nginx-scgi;

    # Compression for text responses (HTML, CSS, JS, JSON, SVG). woff2 and images are already compressed.
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;
    brotli on;
    brotli_comp_level 5;
    brotli_min_length 512;
    brotli_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    server {
        listen ${PORT};
        listen [::]:${PORT};
        root /var/www/html/public;
        index index.php;
        charset utf-8;

        include /etc/nginx/security-headers.conf;

        # Hashed build output (css/js) and fonts: the name changes with the content → cache for a year.
        location ~ ^/(build|fonts)/ {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            include /etc/nginx/security-headers.conf;
            access_log off;
            try_files $uri =404;
        }

        location = /favicon.svg {
            add_header Cache-Control "public, max-age=86400" always;
            include /etc/nginx/security-headers.conf;
            access_log off;
            try_files $uri =404;
        }

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            include /etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT $realpath_root;
            fastcgi_hide_header X-Powered-By;
        }

        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
