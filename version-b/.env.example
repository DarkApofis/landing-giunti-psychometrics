# Giunti Psychometrics — version B (Laravel)
# Copy to .env and run `php artisan key:generate`. Never commit .env or APP_KEY.

APP_NAME="Giunti Psychometrics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Used for the canonical URL and the Open Graph url.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_TIMEZONE=Europe/Rome

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No database: sessions, cache and queues never touch one (see docs/ASSUMPTIONS.md B6).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
# CACHE_PREFIX=

QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The contact form logs messages instead of sending email.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="assistenza@example.com"
MAIL_FROM_NAME="${APP_NAME}"
